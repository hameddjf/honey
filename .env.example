# =============================================================================
# Nika Honey — canonical environment file (project root)
# =============================================================================
# Copy this file to `.env` (same folder) and fill in the blanks for your
# machine/deployment. Never commit the real `.env` file.
#
# This ONE file is read by both halves of the project:
#   - backend/  (Django reads it via backend/config/settings/base.py)
#   - frontend/ (Next.js reads it via frontend/next.config.mjs)
# Keep it at the repository root — do not create a second .env inside
# backend/ or frontend/, or you'll end up with two sources of truth.
#
# Values that are already safe to use for local development are filled in
# below. Values that depend on a real deployment (a live URL, a real Gmail
# account, etc.) are intentionally left blank — see the comment above each.
#
# Intended production hosting target (not deployed by this project — see
# the delivery report for what's config-ready vs. what deployment itself
# still requires):
#   Frontend: Cloudflare Workers
#   Backend:  Render Free Web Service
#   Database: Neon PostgreSQL (via DATABASE_URL, see the DATABASE section)
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND — Django core
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true

# Comma-separated host/domain list. Local defaults are enough for dev.
# Production target is a Render Web Service — add its real domain once
# known (e.g. nika-honey.onrender.com, or a custom domain if you attach one).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# BACKEND — CORS / CSRF (must list every origin the frontend is served from)
# -----------------------------------------------------------------------------
# Local Next.js dev server is enough for local dev. Production target is
# Cloudflare Workers — add your real deployed frontend origin (e.g.
# https://your-worker.workers.dev, or a custom domain) once known; this is
# the "real production frontend URL" this project doesn't know yet.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Real production frontend origin(s) — unknown until deployed, leave blank
# or append to the two lists above once you have it:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-real-frontend.example
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-real-frontend.example

# -----------------------------------------------------------------------------
# BACKEND — locale
# -----------------------------------------------------------------------------
DJANGO_LANGUAGE_CODE=fa
DJANGO_TIME_ZONE=Asia/Tehran

# -----------------------------------------------------------------------------
# BACKEND — email (password-reset OTP)
# -----------------------------------------------------------------------------
# With EMAIL_HOST_USER left blank, the project automatically falls back to
# Django's console backend (OTP codes print to the server log) — this is
# fine, and the default, for local development. Fill in real Gmail
# credentials only when you actually want emails to be sent.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# Real Gmail address to send OTP/reset emails from — unknown, leave blank:
EMAIL_HOST_USER=
# Real Gmail SMTP *app password* (not your normal Gmail password) — unknown,
# leave blank: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=
# Defaults to EMAIL_HOST_USER when blank; override to send from a different
# display address once you have EMAIL_HOST_USER set.
DEFAULT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# BACKEND — production-only security (has no effect while DJANGO_DEBUG=true)
# -----------------------------------------------------------------------------
# Forces HTTP -> HTTPS redirects; leave "true" once actually deployed behind
# HTTPS (the platform's edge/proxy). Safe to leave as-is for local dev.
DJANGO_SECURE_SSL_REDIRECT=true
# Optional: enables HTTP Strict-Transport-Security once deployed behind a
# stable HTTPS domain (0 = disabled, the default). Only takes effect in
# production.py; harmless while DJANGO_DEBUG=true. Leave at 0 until you're
# sure the production domain is final — HSTS is cached aggressively by
# browsers and hard to undo quickly.
# DJANGO_SECURE_HSTS_SECONDS=0

# -----------------------------------------------------------------------------
# DATABASE — SQLite for local dev, PostgreSQL (Neon) for deployed production.
# -----------------------------------------------------------------------------
# Environment-driven, not hardcoded: backend/config/settings/base.py checks
# DATABASE_URL first.
#   - DATABASE_URL unset (as below)  -> local sqlite3 file (backend/db.sqlite3).
#     This is what local development and this repo's test suite use.
#   - DATABASE_URL set                -> that PostgreSQL database instead.
#     This is what a deployed backend (e.g. on Render) should use, pointed
#     at a Neon Postgres database. Real production connection string is
#     unknown until you create the Neon project — leave blank until then:
# DATABASE_URL=
# IMPORTANT: config/settings/production.py refuses to boot (raises
# RuntimeError) if DATABASE_URL is missing, or doesn't resolve to a
# PostgreSQL connection — a deployed instance can never silently fall back
# to SQLite. This check only runs under
# DJANGO_SETTINGS_MODULE=config.settings.production; local development
# (config.settings.development) is unaffected and still defaults to SQLite.
# Example of the shape a real Neon connection string has (for reference
# only — do not uncomment/fill with a fake value):
#   postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
#
# Discrete POSTGRES_* variables are also supported as a fallback if
# DATABASE_URL isn't set, but DATABASE_URL is the one Neon actually gives
# you — prefer it. Documented here, left commented/disabled:
# POSTGRES_DB=nika_honey
# POSTGRES_USER=nika_honey
# POSTGRES_PASSWORD=nika_honey
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# FRONTEND — Next.js
# -----------------------------------------------------------------------------
# Local Django dev server (see frontend/lib/api/client.js).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Real deployed backend URL (e.g. https://nika-honey.onrender.com/api/v1) —
# unknown until deployed. Once you have it, replace the value above with it
# for a production build/deploy (e.g. set it in the Cloudflare Workers
# project's Environment Variables — this file is for local dev only and is
# never uploaded to Cloudflare).

# Canonical site URL — used for metadataBase, canonical/OpenGraph URLs,
# robots.txt's Host/Sitemap lines, and sitemap.xml entries (see
# frontend/lib/seo.js). Local development can stay on localhost; the real
# production domain (unknown until deployed) must be set as an environment
# variable on the hosting platform (e.g. Cloudflare Workers) — never
# hardcoded in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

